<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:padding">10dp</item>
    </style>

    <!-- Invisible activity used by launcher shortcuts -->
    <style name="Theme.Kalimote.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">true</item>
    </style>
</resources>
